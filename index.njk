---
layout: base.njk
title: Giacomo Zucco
---
<section class="hero">
  <img class="avatar" src="/img/giacomo.png" alt="Portrait of Giacomo Zucco" width="160" height="160">
  <div>
    <h1 class="hero-name">Giacomo Zucco<span class="cursor" aria-hidden="true"></span></h1>
    <p class="hero-tag">{{ site.tagline }}</p>
  </div>
</section>

<section class="disclosure" aria-labelledby="disclosure-title">
  <h2 id="disclosure-title"><span class="dim">#</span> disclosure</h2>
  <p>I am involved as a board member, local director, investor or advisor in the following entities: {% set lastWord = "and" %}{% set govName = "the Government of El Salvador" %}{% include "orgs.njk" %}.</p>
</section>

<section aria-labelledby="featured-title">
  <h2 id="featured-title"><span class="dim">#</span> featured</h2>
  {% if featured.announcement %}
  <div class="announcement">
    <h3 class="item-title">{% if featured.announcement.url %}<a href="{{ featured.announcement.url }}">{{ featured.announcement.title }}</a>{% else %}{{ featured.announcement.title }}{% endif %}</h3>
    {% if featured.announcement.text %}<p class="item-desc">{{ featured.announcement.text }}</p>{% endif %}
  </div>
  {% else %}
  <ul class="items">
    {% set item = collections.everything | featuredItem(featured) %}{% include "item.njk" %}
  </ul>
  {% endif %}
  <p><a class="more" href="/content/">browse everything: articles, talks, interviews, podcasts →</a></p>
</section>
